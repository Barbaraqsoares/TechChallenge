      "key": "clienteEmail",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Cadastro de usuario",
      "description": "Requisito: identificar o cliente por nome, e-mail e senha, validando o formato do e-mail e exigindo senha segura (minimo 8 caracteres, com letra, numero e caractere especial).",
      "item": [
        {
          "name": "1.1 Senha fraca e recusada (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 400\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test(\"Erro padronizado com traceId\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\");",
                  "    pm.expect(pm.response.json().traceId).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "",
                  "pm.test(\"Mensagem: A senha deve possuir no mínimo 8 caracteres.\", function () {",
                  "    pm.expect(pm.response.json().detail).to.eql(\"A senha deve possuir no mínimo 8 caracteres.\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Mostra a validacao de senha segura exigida pelo enunciado.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Teste\",\n  \"email\": \"teste@fiap.com\",\n  \"login\": \"teste-senha\",\n  \"password\": \"123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "1.2 E-mail invalido e recusado (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 400\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test(\"Erro padronizado com traceId\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\");",
                  "    pm.expect(pm.response.json().traceId).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "",
                  "pm.test(\"Mensagem: E-mail inválido.\", function () {",
                  "    pm.expect(pm.response.json().detail).to.eql(\"E-mail inválido.\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Mostra a validacao de formato de e-mail.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Teste\",\n  \"email\": \"isso-nao-e-um-email\",\n  \"login\": \"teste-email\",\n  \"password\": \"Senha@123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "1.3 Cadastro valido (201)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Sufixo unico por execucao: permite rodar a colecao varias vezes seguidas",
                  "// sem precisar recriar o banco.",
                  "const sufixo = Date.now().toString().slice(-6);",
                  "",
                  "pm.collectionVariables.set(\"clienteLogin\", \"cliente\" + sufixo);",
                  "pm.collectionVariables.set(\"clienteEmail\", \"cliente\" + sufixo + \"@fiap.com\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Nasce com perfil Cliente e sem expor a senha\", function () {",
                  "    const corpo = pm.response.json();",
                  "",
                  "    pm.expect(corpo.perfil).to.eql(2); // 1 = Admin, 2 = Client",
                  "    pm.expect(corpo).to.not.have.property(\"password\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Cria o usuario comum usado no restante da demonstracao. A senha e gravada com hash BCrypt e nunca volta na resposta.\n\nO login e gerado com um sufixo unico a cada execucao, para a colecao poder ser repetida sem recriar o banco - util ao ensaiar a gravacao.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Cliente Teste\",\n  \"email\": \"{{clienteEmail}}\",\n  \"login\": \"{{clienteLogin}}\",\n  \"password\": \"Senha@123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },

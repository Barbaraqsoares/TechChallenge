                  "pm.test(\"Mensagem: O jogo já está na biblioteca do usuário.\", function () {",
                  "    pm.expect(pm.response.json().detail).to.eql(\"O jogo já está na biblioteca do usuário.\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenCliente}}"
              }
